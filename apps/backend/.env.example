# Required: obtain from https://finnhub.io/dashboard after creating a free account
FINNHUB_API_KEY=your_api_key_here

# Port the NestJS server listens on (default: 3000)
PORT=3000

# Allowed origin for CORS and Socket.IO (must match the frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database file path (relative to apps/backend, default: data/crypto.db)
DB_PATH=data/crypto.db
